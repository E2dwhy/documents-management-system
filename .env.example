# ---------------------------------------------------------------------------
# Supabase — projet
# Recuperer ces valeurs dans Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Cle "publishable" (nouveau systeme de cles Supabase, prefixe sb_publishable_).
# Cote client par conception : doit garder le prefixe NEXT_PUBLIC_.
# Equivalent a l'ancienne cle "anon" (NEXT_PUBLIC_SUPABASE_ANON_KEY) si votre
# projet utilise encore l'ancien systeme — voir src/lib/supabase/env.ts.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Cle "secret" (prefixe sb_secret_) : reservee au code serveur (Server
# Actions, Route Handlers, scripts). NE JAMAIS l'exposer au client (pas de
# prefixe NEXT_PUBLIC_). Equivalent a l'ancienne cle "service_role"
# (SUPABASE_SERVICE_ROLE_KEY) si votre projet utilise l'ancien systeme.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint JWKS — non utilise par le code applicatif aujourd'hui (les SDK
# Supabase gerent la verification de session), conserve pour reference.
SUPABASE_JWKS_URL=https://xxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# Mot de passe Postgres — serveur uniquement, utilise pour appliquer les
# migrations SQL (psql / supabase CLI). Jamais lu par le code applicatif.
# NE JAMAIS prefixer par NEXT_PUBLIC_.
SUPABASE_DB_PASSWORD=xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# URL publique de l'app (utilisee pour les liens dans les emails, le manifest
# PWA, les exports PDF, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nom de l'organisation par defaut (entete, etiquettes QR, exports) — tant
# qu'aucun admin n'a personnalise le nom/logo via Administration > Parametres
# (stocke alors en base, voir supabase/migrations/*_app_settings.sql).
NEXT_PUBLIC_ORG_NAME="Mon Organisation"

# Fuseau horaire applicatif (dates affichees en francais, format dd/MM/yyyy HH:mm)
NEXT_PUBLIC_APP_TIMEZONE=Africa/Abidjan

# ---------------------------------------------------------------------------
# Laravel fallback (NE PAS RENSEIGNER sauf bascule explicite hors Supabase —
# voir README section "Repli Laravel"). Conserve ici pour reference future.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
