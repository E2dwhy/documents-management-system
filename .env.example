# ---------------------------------------------------------------------------
# Supabase — projet
# Recuperer ces valeurs dans Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cle service_role (secrete) : reservee au code serveur (Route Handlers,
# Server Actions, Edge Functions). NE JAMAIS l'exposer au client (pas de
# prefixe NEXT_PUBLIC_). Utilisee pour l'invitation d'utilisateurs, etc.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# URL publique de l'app (utilisee pour les liens dans les emails, le manifest
# PWA, les exports PDF, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nom de l'organisation affiche dans l'entete, les etiquettes QR et les exports
NEXT_PUBLIC_ORG_NAME="Mon Organisation"

# Fuseau horaire applicatif (dates affichees en francais, format dd/MM/yyyy HH:mm)
NEXT_PUBLIC_APP_TIMEZONE=Africa/Abidjan

# ---------------------------------------------------------------------------
# Laravel fallback (NE PAS RENSEIGNER sauf bascule explicite hors Supabase —
# voir README section "Repli Laravel"). Conserve ici pour reference future.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
